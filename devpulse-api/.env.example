# Copy this file to .env and fill in real values.
# Never commit the actual .env file to GitHub.

SECRET_KEY=change-this-to-a-random-string
FLASK_DEBUG=true
PORT=5000

# Sign this with a long random string in production.
JWT_SECRET=change-this-to-a-long-random-string

# Free key from https://console.groq.com — required for the AI
# features (/api/ai/generate-description, /api/ai/suggest-tasks).
GROQ_API_KEY=

# Which frontend URL is allowed to call this API from a browser.
ALLOWED_ORIGIN=http://localhost:5173

# Leave unset for local SQLite. For PostgreSQL:
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/dbname
